# Copy to .env on the server. Never commit .env.
BASE_DOMAIN=yourdomain.com
ACME_EMAIL=you@example.com
SESSION_SECRET=change-me-to-a-long-random-string
# Optional: serve this store on the bare domain / non-store hosts
DEFAULT_STORE=

# AI (optional — site works fully without these; chat says AI isn't set up)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b

# Marketing page + self-serve signup on the bare domain
# "Talk to us" button and the "Message us to go live" link in new stores' admin,
# e.g. https://m.me/yourpage or mailto:hello@yourdomain.com
CONTACT_URL=
