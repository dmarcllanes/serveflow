{
	email {$ACME_EMAIL}
	# Only issue certs for hosts the app approves (existing stores + apex/www)
	on_demand_tls {
		ask http://app:5001/_tls_check
	}
}

https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	request_body {
		max_size 8MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	reverse_proxy app:5001
}

http:// {
	redir https://{host}{uri} permanent
}
